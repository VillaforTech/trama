{
  "name": "trama-code",
  "version": "0.1.0",
  "private": true,
  "description": "Understand a codebase, trace its behavior, and prove what you have learned.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "demo:build": "tsx scripts/build-demo.ts && vite build --base=./ --mode demo",
    "setup": "npm run build",
    "desktop": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "test:desktop": "playwright test -c desktop/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@xyflow/react": "^12.0.0",
    "express": "^5.1.0",
    "ignore": "^7.0.16",
    "jose": "6.2.18",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.10.1",
    "tsx": "^4.0.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch@>=7 <11.0.1": "^11.0.1"
    },
    "@electron/universal": {
      "minimatch@>=7 <11.0.1": "^11.0.1"
    }
  },
  "main": "desktop/main.cjs",
  "author": "Roberto Villafuerte (VillaforTech)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VillaforTech/trama.git"
  },
  "homepage": "https://github.com/VillaforTech/trama"
}
